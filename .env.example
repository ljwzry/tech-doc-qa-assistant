# ============================================================
# 技术文档问答助手 - 环境变量配置模板
# ============================================================
# 使用说明：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 根据下方指南填写你自己的 AI 配置
#   3. 修改 .env 后需重启后端服务才能生效
#
#   详细配置指南请参考：AI模型配置指南.md
# ============================================================


# ============ LLM 大语言模型配置 ============
# 支持三种方案，取消对应方案的注释并填写信息即可

# ---- 方案 A：SiliconFlow 中转平台（推荐，国内可访问，性价比高）----
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-在此填入你的-SiliconFlow-API-Key
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3

# ---- 方案 B：DeepSeek 官方 API ----
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-在此填入你的-DeepSeek-官方-API-Key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ---- 方案 C：Ollama 本地模型（完全离线，无需 API Key）----
# 前置条件：安装 Ollama (https://ollama.com) 并拉取模型：ollama pull qwen2.5:7b
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen2.5:7b


# ============ Embedding 向量模型配置 ============
# BGE-small-zh：约 100MB，纯 CPU 环境速度快，推荐
# BGE-m3：约 2GB，效果更好，建议有 GPU 时使用
EMBEDDING_MODEL=BAAI/bge-small-zh
EMBEDDING_DEVICE=cpu
# CPU 线程数（建议设为物理核心数的一半）
EMBEDDING_THREADS=8


# ============ 数据存储配置 ============
CHROMA_PERSIST_DIR=./data/chroma_db


# ============ 应用配置 ============
APP_HOST=0.0.0.0
APP_PORT=8000


# ============ API 鉴权配置（生产环境建议启用）============
# 启用后，所有 API 请求需携带 Authorization: Bearer <API_KEY>
# /health 端点免鉴权
AUTH_ENABLED=false
# API_KEY=your-secure-api-key-here
