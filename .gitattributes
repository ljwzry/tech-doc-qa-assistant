# 自动识别文本文件并规范化换行符
* text=auto eol=lf

# Python 文件
*.py text eol=lf
*.pyi text eol=lf

# 配置文件
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.env text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf

# 文档
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf

# 前端
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf

# Shell 脚本
*.sh text eol=lf
*.bash text eol=lf

# Windows 批处理保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pkl binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.bin binary
*.whl binary
*.pyc binary
